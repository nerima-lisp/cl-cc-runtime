;;;; cl-cc-runtime.asd -- the runtime library extracted from the cl-cc monorepo.
;;;;
;;;; Both systems live in this one file. There is no cl-cc-runtime-test.asd:
;;;; a second .asd at the root duplicates the eight metadata fields, and the
;;;; two copies drift.
;;;;
;;;; System names are written as STRINGS rather than #:symbols or :keywords, so
;;;; that reading this file does not depend on the reader's current package,
;;;; and so that a grep for a system name has exactly one form to match. This
;;;; file previously mixed :cl-cc-runtime with "cl-cc-runtime-test".

(in-package #:asdf-user)

(defsystem "cl-cc-runtime"
  :description "cl-cc runtime library: rt-* primitives, GC, heap, frame, value codec, and concurrency"
  :long-description "The target runtime the cl-cc compiler emits against: the :cl-cc/runtime package system, a generational garbage collector, the heap and allocator, value representation and codecs, images, FFI, and the lock-free and wait-free concurrency primitives. It builds on the sibling nerima-lisp kits for structured logging, process execution and JSON rather than reimplementing them."
  :author "takeokunn <bararararatty@gmail.com>"
  :maintainer "takeokunn <bararararatty@gmail.com>"
  :license "MIT"
  :version "0.1.2"
  :homepage "https://github.com/nerima-lisp/cl-cc-runtime"
  :bug-tracker "https://github.com/nerima-lisp/cl-cc-runtime/issues"
  :source-control (:git "https://github.com/nerima-lisp/cl-cc-runtime.git")
  :depends-on ("cl-log-kit" "cl-process-kit" "cl-json-kit" "cl-host-kit")
  :pathname "src"
  :serial t
  :components
  ((:module "package-values" :pathname "values" :serial t :components ((:file "package")))
   (:module "package-dynamic-binding" :pathname "dynamic-binding" :serial t :components ((:file "package")))
   (:module "package-execution" :pathname "execution" :serial t :components ((:file "package")))
   (:module "package-conditions" :pathname "conditions" :serial t :components ((:file "package")))
   (:module "package-memory" :pathname "memory" :serial t :components ((:file "package")))
   (:module "package-memory-infra" :pathname "memory/infra" :serial t :components ((:file "package")))
   (:module "package-concurrency" :pathname "concurrency" :serial t :components ((:file "package")))
   (:module "package-clos" :pathname "clos" :serial t :components ((:file "package")))
   (:module "package-compression" :pathname "compression" :serial t :components ((:file "package")))
   (:module "package-images" :pathname "images" :serial t :components ((:file "package")))
   (:module "package-os" :pathname "os" :serial t :components ((:file "package")))
   (:module "package-os-infra" :pathname "os/infra" :serial t :components ((:file "package")))
   (:module "package-observability" :pathname "observability" :serial t :components ((:file "package")))
   (:module "package-profiling" :pathname "profiling" :serial t :components ((:file "package")))
   (:module "package-profiling-infra" :pathname "profiling/infra" :serial t :components ((:file "package")))
   (:module "package-resilience" :pathname "resilience" :serial t :components ((:file "package")))
   (:module "package-serialization" :pathname "serialization" :serial t :components ((:file "package")))
   (:module "package-cryptography" :pathname "cryptography" :serial t :components ((:file "package")))
   (:module "package-distributed-state" :pathname "distributed-state" :serial t :components ((:file "package")))
   (:file "package")
   (:module "implementation-values" :pathname "values" :serial t :components ((:file "runtime")
      (:file "runtime-list")
      (:file "runtime-ops")
      (:file "runtime-strings")
      (:file "runtime-weak-hash-table")
      (:file "runtime-math-io")
      (:file "hash-weak")
      (:file "runtime-packages")
      (:file "value-tags")
      (:file "value")
      (:file "value-codec")
      (:file "value-pinned-array")))
   (:module "implementation-dynamic-binding" :pathname "dynamic-binding" :serial t :components ((:file "runtime-dynamic-binding")))
   (:module "implementation-execution" :pathname "execution" :serial t :components ((:file "runtime-code-cache")))
   (:module "implementation-conditions" :pathname "conditions" :serial t :components ((:file "runtime-conditions")))
   (:module "implementation-memory" :pathname "memory" :serial t :components ((:file "runtime-region")
      (:file "frame")
      (:file "heap-data")
      (:file "heap-core")
      (:file "heap-sanitizer")
      (:file "heap-layout")
      (:file "heap-region")
      (:file "heap-access")
      (:file "heap-forwarding")
      (:file "heap-numa")
      (:file "heap-stats")
      (:file "heap-free-list")
      (:file "heap-resize")
      (:file "heap-trace")
      (:file "gc-references")
      (:file "gc-weak-processing")
      (:file "gc-profile")
      (:file "gc-data")
      (:file "gc-safepoints")
      (:file "gc-policy")
      (:file "gc-pinning")
      (:file "gc-roots-objects")
      (:file "gc-stackmaps")
      (:file "gc-binding-scan")
      (:file "gc-heap-verify")
      (:file "gc-alloc")
      (:file "gc-copy")
      (:file "gc-tlab")
      (:file "gc-minor")
      (:file "gc-write-barrier")
      (:file "gc-finalizers")
      (:file "gc-major-mark")
      (:file "gc-mark-work")
      (:file "gc-workers")
      (:file "gc-major-sweep")
      (:file "gc-compact")
      (:file "gc-concurrent-sweep")
      (:file "gc-region-collect")
      (:file "gc-major-collect")
      (:file "gc-sweep-telemetry")
      (:file "heap-hugepages")
      (:file "heap-los")
      (:file "allocator")
      (:file "gc-collector-strategies")
      (:file "mmap-api")
      (:module "infra" :pathname "infra" :serial t :components ((:file "mmap")))))
   (:module "implementation-concurrency" :pathname "concurrency" :serial t :components ((:file "runtime-stack")
      (:file "deadlock")
      (:file "sync")
      (:file "portable")
      (:file "lockfree")
      (:file "spsc")
      (:file "ebr")
      (:file "hazard")
      (:file "rcu")
      (:file "qsbr")
      (:file "scheduler")
      (:file "scheduler-work-stealing")
      (:file "scheduler-native-thread")
      (:file "scheduler-thread-pool")
      (:file "future")
      (:file "channel")
      (:file "actor")
      (:file "task")
      (:file "stm")
      (:file "async")
      (:file "effects")
      (:file "fiber")
      (:file "context")
      (:file "parallel-algo")))
   (:module "implementation-clos" :pathname "clos" :serial t :components ((:file "runtime-clos")
      (:file "runtime-clos-dispatch")
      (:file "runtime-clos-applicability")
      (:file "runtime-clos-invoke")))
   (:module "implementation-compression" :pathname "compression" :serial t :components ((:file "compress")))
   (:module "implementation-images" :pathname "images" :serial t :components ((:file "image")
      (:file "image-core")
      (:file "image-core-graph")
      (:file "image-core-persist")
      (:file "image-restore")))
   (:module "implementation-os" :pathname "os" :serial t :components ((:file "runtime-io")
      (:file "runtime-pathnames")
      (:file "os")
      (:file "signals")
      (:file "ffi")
      (:file "ffi-embedding-api")
      (:file "xom")
      (:file "net")
      (:file "topology")
      (:file "topology-numa-memory")
      (:module "infra" :pathname "infra" :serial t :components ((:file "pinned-array") (:file "runtime-packages") (:file "runtime-pathnames")))))
   (:module "implementation-observability" :pathname "observability" :serial t :components ((:file "otel")
      (:file "log")
      (:file "metrics")))
   (:module "implementation-profiling" :pathname "profiling" :serial t :components ((:module "infra" :pathname "infra" :serial t :components ((:file "perf"))) (:file "continuous-profile") (:file "continuous-profile-export")))
   (:module "implementation-resilience" :pathname "resilience" :serial t :components ((:file "ratelimit")))
   (:module "implementation-serialization" :pathname "serialization" :serial t :components ((:file "serialize")
      (:file "deserialize")))
   (:module "implementation-cryptography" :pathname "cryptography" :serial t :components ((:file "crypto")
      (:file "crypto-base64")))
   (:module "implementation-distributed-state" :pathname "distributed-state" :serial t :components ((:file "consensus")
      (:file "crdt"))))
  :in-order-to ((test-op (test-op "cl-cc-runtime/test"))))

;;; The aggregate test system contains one nested module per feature. The
;;; runtime system reaches it through its :in-order-to test-op relation.
(defsystem "cl-cc-runtime/test"
  :description "Test system for cl-cc-runtime."
  :author "takeokunn <bararararatty@gmail.com>"
  :maintainer "takeokunn <bararararatty@gmail.com>"
  :license "MIT"
  :version "0.1.2"
  :homepage "https://github.com/nerima-lisp/cl-cc-runtime"
  :bug-tracker "https://github.com/nerima-lisp/cl-cc-runtime/issues"
  :source-control (:git "https://github.com/nerima-lisp/cl-cc-runtime.git")
  :depends-on ("cl-cc-runtime" "cl-weave")
  :pathname "t"
  :serial t
  :components
  ((:module "distributed-state" :pathname "distributed-state" :serial t :components ((:file "package")
      (:file "consensus-test")
      (:file "crdt-test")))
   (:module "cryptography" :pathname "cryptography" :serial t :components ((:file "package")
      (:file "crypto-test")))
   (:module "profiling" :pathname "profiling" :serial t :components ((:file "package")
      (:file "continuous-profile-test")
      (:file "perf-test")))
   (:module "concurrency" :pathname "concurrency" :serial t :components ((:file "package")
      (:file "deadlock-test")
      (:file "parallel-algo-test")
      (:file "lockfree-test")
      (:file "spsc-test")
      (:file "hazard-test")
      (:file "ebr-test")
      (:file "rcu-test")
      (:file "qsbr-test")
      (:file "actor-test")
      (:file "channel-test")
      (:file "stm-test")
      (:file "task-test")
      (:file "future-test")
      (:file "fiber-test")
      (:file "scheduler-test")
      (:file "effects-test")
      (:file "context-test")
      (:file "runtime-stack-test")
      (:file "sync-test")
      (:file "async-test")
      (:file "portable-test")))
   (:module "memory" :pathname "memory" :serial t :components ((:file "package")
      (:file "frame-test")
      (:file "gc-requirements-test")
      (:file "gc-major-sweep-test")
      (:file "gc-minor-test")
      (:file "gc-sweep-telemetry-test")
      (:file "gc-write-barrier-test")
      (:file "heap-sanitizer-test")
      (:file "heap-trace-test")
      (:file "runtime-data-ops-test")
      (:file "allocator-test")
      (:file "runtime-stack-test")
      (:file "gc-collector-strategies-test")
      (:file "gc-data-test")
      (:file "frame-boundary-test")
      (:file "runtime-math-io-test")
      (:file "gc-workers-test")
      (:file "gc-major-sweep-incremental-test")
      (:file "gc-region-collect-test")))
   (:module "conditions" :pathname "conditions" :serial t :components ((:file "package")
      (:file "gc-requirements-test")
      (:file "runtime-math-io-test")
      (:file "runtime-conditions-test")))
   (:module "execution" :pathname "execution" :serial t :components ((:file "package")
      (:file "gc-requirements-test")
      (:file "runtime-test")
      (:file "runtime-stack-test")
      (:file "runtime-conditions-test") (:file "mutation-test")))
   (:module "values" :pathname "values" :serial t :components ((:file "package")
      (:file "gc-requirements-test")
      (:file "runtime-strings-chars-test")
      (:file "runtime-data-ops-test")
      (:file "runtime-test")
      (:file "facade-test")
      (:file "runtime-packages-test")
      (:file "value-test")
      (:file "runtime-ops-test")
      (:file "runtime-math-io-test")))
   (:module "clos" :pathname "clos" :serial t :components ((:file "package")
      (:file "runtime-clos-test")
      (:file "runtime-test")
      (:file "runtime-conditions-test")))
   (:module "os" :pathname "os" :serial t :components ((:file "package")
      (:file "runtime-io-test")
      (:file "os-test")
      (:file "signals-test")
      (:file "runtime-math-io-test")
      (:file "runtime-pathnames-test")))
   (:module "serialization" :pathname "serialization" :serial t :components ((:file "package")
      (:file "serialize-test")))
   (:module "images" :pathname "images" :serial t :components ((:file "package")
      (:file "image-core-test")
      (:file "image-test")))
   (:module "observability" :pathname "observability" :serial t :components ((:file "package")
      (:file "metrics-test")))
   (:module "compression" :pathname "compression" :serial t :components ((:file "package")
      (:file "compress-test")))
   (:module "resilience" :pathname "resilience" :serial t :components ((:file "package")
      (:file "ratelimit-test")))
   (:module "dynamic-binding" :pathname "dynamic-binding" :serial t :components ((:file "package")
      (:file "runtime-math-io-test"))))
  :perform (test-op (op system)
             (declare (ignore op system))
             (unless (funcall (find-symbol "RUN-ALL" (find-package "CL-WEAVE"))
                              :reporter :spec :pass-with-no-tests nil)
               (error "cl-cc-runtime tests failed"))))
